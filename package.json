{
  "name": "water-my-plants",
  "version": "2.0.0",
  "private": true,
  "description": "A plant watering scheduler — Express + Knex + PostgreSQL API with a React frontend.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon --require dotenv/config server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node -r dotenv/config server/index.js",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "cross-env NODE_ENV=testing vitest run",
    "test:integration": "cross-env NODE_ENV=testing vitest run --config vitest.integration.config.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4",
    "vitest": "^4.1.10"
  }
}
