# Copy to .env and fill in. .env is gitignored.

# Which knexfile.js block to use: development | testing | production
NODE_ENV=development

# Postgres connection strings. Locally these can point at a database created
# with `createdb water_my_plants`; in production Vercel injects DATABASE_URL
# from the Neon integration.
DEV_DATABASE_URL=postgres://localhost:5432/water_my_plants
TESTING_DATABASE_URL=postgres://localhost:5432/water_my_plants_test
DATABASE_URL=

# Signs and verifies session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# bcrypt work factor. Higher is slower and stronger.
BCRYPT_ROUNDS=10

# Local API port. The Vite dev server proxies /api here.
PORT=9000

# Only needed if the client is ever hosted on a different origin than the API.
# Comma-separated list of allowed origins.
# CORS_ORIGIN=https://example.com
